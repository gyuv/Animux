# ── Metadata ────────────────────────────────────────────────────────────────
# Everything here has a working default; none of it is required to run the app.
# ANILIST_ENDPOINT=https://graphql.anilist.co
# ANILIST_USER_AGENT=Animux/3.0 (+https://your-domain.example; contact: you@example.com)
# ANILIST_RATE_PER_MIN=24
# ANILIST_BURST=4

# ── Streaming: option 1, your own licensed backend ──────────────────────────
# Takes precedence over the scraper APIs below.
# STREAM_PROVIDER_URL=https://your-backend.example/resolve
# STREAM_PROVIDER_KEY=
# STREAM_SUBTITLE_HOSTS=cdn.example.com,subs.example.com

# ── Streaming: option 2, self-hosted scraper APIs ───────────────────────────
# Deploy these yourself; neither project offers a public instance. They scrape
# sites that hold no licence to the content they serve.
# CONSUMET_API_URL=https://your-consumet.example
# ANIWATCH_API_URL=https://your-aniwatch.example

# Signs the proxied stream URLs. Set this to 32+ random characters —
# without it, links break on restart and across instances.
#   openssl rand -hex 32
# STREAM_PROXY_SECRET=

# Sent upstream alongside the Referer; the default is a desktop Chrome string.
# STREAM_PROXY_USER_AGENT=

# ── Streaming servers ───────────────────────────────────────────────────────
# Viewers pick these in the player under Playback -> Server. The names shown
# there are this app's own (Vega, Orion, Lyra, Draco, Nova, Atlas); which
# upstream sits behind each is deliberately not published to viewers, so a
# backend can be swapped without a name losing its meaning.
#
# Vega — megaplay.buzz, addressed directly by AniList id. Needs NOTHING
# deployed, so it is the one that works out of the box. Disable with:
# MEGAPLAY_ENABLED=0
# MEGAPLAY_URL=https://megaplay.buzz
#
# Nova and Atlas — github.com/walterwhite-69/ReAnime.to-API, self-hosted
# (the repo ships a railway.json). These are the two that carry real subtitle
# tracks and chapter marks. Dark until this is set:
# REANIME_API_URL=https://your-reanime.example
#
# Orion, Lyra, Draco — AniHeist, configured just below.

# ── Streaming: AniHeist ─────────────────────────────────────────────────────
# https://github.com/ZenHamza/AniHeist-api — a separate Python service (it
# ships a Dockerfile and a compose file). Tried FIRST, because it takes the
# AniList id directly: no catalogue search, no title scoring, so none of the
# "wrong season" failures the other sources can have.
# On by default against the public instance; point this at your own deployment.
# ANIHEIST_API_URL=https://api.aniheist.com
# ANIHEIST_ENABLED=0
#
# Servers are picked in the player under Playback → Server: Auto, Pewe, Ally,
# Moo. All are requested with source=miruro, which is the backend returning
# direct HLS/MP4 — the default backend answers with an iframe embed page that
# no hls.js player can use.

# ── Streaming: option 3, in-process scraping ────────────────────────────────
# On by default, nothing to deploy. HIANIME_ENABLED=0 turns it off — worth
# doing if it reports "did not answer", which means your host cannot reach the
# mirror below and the eight seconds it spends finding that out are taken from
# the providers queued behind it.
# HIANIME_ENABLED=0
# ANIWATCH_DOMAIN=aniwatchtv.to
# Comma-separated, in order. Default: animepahe,animekai
# ANIME_PROVIDERS=animepahe,animekai

# ── Catalogue fallback ──────────────────────────────────────────────────────
# When AniList refuses us (429 over its limit, or 403 for a blocked address —
# not rare on a shared serverless IP) the listing used to go blank. It now
# falls back to MyAnimeList through Jikan, and maps MAL ids back to AniList
# ids so titles still open and still play. Both have working defaults.
# JIKAN_API_URL=https://api.jikan.moe/v4
# ANIME_ID_MAP_URL=https://animeapi.my.id

# ── Site ────────────────────────────────────────────────────────────────────
# Used for absolute URLs in Open Graph metadata.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
